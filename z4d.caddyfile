# Caddy reverse proxy for Domoticz and the Zigbee for Domoticz WebUI.
# Step by step, with the checks to run:
# https://zigbeefordomoticz.github.io/wiki/en-eng/HowTo_Reverse-Proxy-with-Caddy.html
#
# Before using it:
# - set the plugin "Plugin WebUI port" to 127.0.0.1:9440, so the WebUI is only
#   reachable through Caddy;
# - replace domoticz.example.com with your domain name;
# - replace the basic_auth line with your user name and the hash printed by
#   `caddy hash-password`. Caddy refuses this file until you do.
#
# Needs Caddy 2.8 or later (basic_auth). Check with: caddy validate --config /etc/caddy/Caddyfile

domoticz.example.com {
	encode gzip

	# One login for everything served under this name: Domoticz and the plugin WebUI.
	# Keep basic_auth without a path: "basic_auth /" would only protect the exact path /.
	basic_auth {
		zigbee <paste the hash printed by caddy hash-password>
	}

	# Zigbee for Domoticz: the WebUI, its REST API and the log downloads
	@z4d path /z4d /z4d/* /rest-z4d/* /download/*
	handle @z4d {
		reverse_proxy 127.0.0.1:9440
	}

	# Everything else is Domoticz
	handle {
		reverse_proxy 127.0.0.1:8080
	}

	log {
		output file /var/log/caddy/domoticz.log
	}
}
